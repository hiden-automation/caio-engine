# Rodar o jarvis localmente (os workflows recebem isso de Secrets/Variables).
DATA_DIR=../caio-data
PREVIEWS_DIR=../previews
JARVIS_PLATFORMS=instagram,threads,linkedin,x
JARVIS_DRY_RUN=1
JARVIS_BUDGET_BRL=450
JARVIS_USD_BRL=5.5

ANTHROPIC_API_KEY=
# Modelo por papel (padrão claude-opus-5-5). Ex.: triagem mais barata:
# JARVIS_MODEL_TRIAGE=claude-haiku-4-5
# JARVIS_EFFORT_WRITER=high

CDN_BASE_URL=https://seuusuario.github.io/caio-cdn
CDN_PUSH_URL=https://x-access-token:TOKEN@github.com/seuusuario/caio-cdn.git

IG_USER_ID=
IG_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:
LINKEDIN_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
YOUTUBE_API_KEY=
